<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="simplePostList" class="com.social.media.application.Social.Media.Application.SimplePostList" scope ="singleton"
         init-method="init"
         destroy-method="destroy"/>
    <bean id="simplePost" class="com.social.media.application.Social.Media.Application.SimplePost" scope = "prototype"
     
         destroy-method="destroy"/>

</beans>